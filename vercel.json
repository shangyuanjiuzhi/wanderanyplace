{
  "redirects": [
    { "source": "/(.*)", "destination": "https://www.wanderanyplace.com/$1", "permanent": true, "has": [{ "type": "host", "value": "wanderanyplace.com" }] },
    { "source": "/travel-guides/(.*)", "destination": "/html/travel-guides/$1", "permanent": true },
    { "source": "/2\\.(.*)\\.html", "destination": "/html/2.$1.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/posts/(.*)", "destination": "/api/route.js" },
    { "source": "/api/posts", "destination": "/api/route.js" },
    { "source": "/api/comments/(.*)", "destination": "/api/route.js" },
    { "source": "/api/comments", "destination": "/api/route.js" },
    { "source": "/api/post-comments/(.*)", "destination": "/api/route.js" },
    { "source": "/api/post-comments", "destination": "/api/route.js" },
    { "source": "/api/admin/(.*)", "destination": "/api/route.js" },
    { "source": "/api/admin", "destination": "/api/route.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/html/travel-guides/community-id_(.+).html", "destination": "/api/route.js" },
    { "source": "/html/(.*)", "destination": "/html/$1" },
    { "source": "/sitemap/(.*)", "destination": "/sitemap/$1" },
    { "source": "/(.*)", "destination": "/html/$1" }
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}