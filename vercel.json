{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/html/(.*)", "destination": "/html/$1" },
    { "source": "/(.*)", "destination": "/html/$1" }
  ],
  "buildCommand": "npm install",
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "installCommand": "npm install"
}
