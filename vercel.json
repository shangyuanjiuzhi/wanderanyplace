{
  "rewrites": [
    { "source": "/api/posts/(.*)", "destination": "/api/route.js" },
    { "source": "/api/posts", "destination": "/api/route.js" },
    { "source": "/api/init-db", "destination": "/api/init-db.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/html/(.*)", "destination": "/html/$1" },
    { "source": "/(.*)", "destination": "/html/$1" }
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}