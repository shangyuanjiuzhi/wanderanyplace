{
  "redirects": [
    { "source": "/(.*)", "destination": "https://www.wanderanyplace.com/$1", "permanent": true, "has": [{ "type": "host", "value": "wanderanyplace.com" }] }
  ],
  "rewrites": [
    { "source": "/api/send-booking-email", "destination": "/api/send-booking-email.js" },
    { "source": "/api/send-feedback", "destination": "/api/send-feedback.js" },
    { "source": "/api/package-lock.json", "destination": "/api/package-lock.json" },
    { "source": "/api/packing-suggestions", "destination": "/api/packing-suggestions.js" },
    { "source": "/api/package.json", "destination": "/api/package.json" },
    { "source": "/api/(.*)", "destination": "/api/route.js" },
    { "source": "/html/travel-guides/community-id_(.*).html", "destination": "/api/route.js" },
    { "source": "/css/(.*)", "destination": "/css/$1" },
    { "source": "/js/(.*)", "destination": "/js/$1" },
    { "source": "/iconfont/(.*)", "destination": "/iconfont/$1" },
    { "source": "/img/(.*)", "destination": "/img/$1" },
    { "source": "/html/(.*)", "destination": "/html/$1" },
    { "source": "/category/(.*)", "destination": "/html/category.html" },
    { "source": "/post-detail/(.*)", "destination": "/html/post-detail.html" },
    { "source": "/post", "destination": "/html/post.html" },
    { "source": "/profile", "destination": "/html/profile.html" },
    { "source": "/login", "destination": "/html/login.html" },
    { "source": "/register", "destination": "/html/register.html" },
    { "source": "/admin", "destination": "/html/admin.html" },
    { "source": "/(.*)", "destination": "/html/$1" }
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}